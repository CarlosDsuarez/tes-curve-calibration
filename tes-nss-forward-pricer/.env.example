# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is the contract.
# ---------------------------------------------------------------------------

# Banco de la Republica statistics service behind SUAMECA.
# Verified 2026-09-07; see docs/suameca_reverse_engineering.md. This is the
# service root: no trailing slash, no endpoint path. The observations endpoint
# is <root>/consultaInformacionSerieXTipoDato?idSerie=&tipoDato=1
SUAMECA_BASE_URL=https://suameca.banrep.gov.co/estadisticas-economicas-back/rest/estadisticaEconomicaRestService

# SUAMECA publishes NO per-ISIN TES prices (fitted curve only). Per-ISIN
# precio_sucio/precio_limpio/tasa_negociacion must come from a manual export.
# Leave blank to make fetch_tes_prices fail loudly instead of silently.
SUAMECA_MANUAL_EXPORT_PATH=

# datos.gov.co (Socrata). The token is OPTIONAL: requests work without it, but
# anonymous calls are throttled harder and share a per-IP pool. Register at
# https://evergreen.data.socrata.com/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Socrata domain and the four-by-four dataset identifier to ingest.
SOCRATA_DOMAIN=www.datos.gov.co
DATOS_GOV_CO_DATASET_ID=xxxx-xxxx

# Local I/O roots (relative to the repository root unless absolute).
TES_DATA_RAW_DIR=data/raw
TES_DATA_PROCESSED_DIR=data/processed

# Network behaviour for the ingestion layer.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environments -----------------------------------------------------------
.venv/
venv/
env/
.env
.env.local

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Data: raw payloads are NEVER versioned; provenance is -------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# The manifests are the exception: they are the audit trail.
!data/manifest.json

# --- Excel ------------------------------------------------------------------
~$*.xls*
excel/*.xlsm.bak
